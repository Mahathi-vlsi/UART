module uart_rx (
    input clk,
    input rst,
    input rx,
    output reg [7:0] rx_data,
    output reg rx_done
);

parameter BAUD_RATE = 9600;
parameter CLK_FREQ = 50000000;
parameter BAUD_COUNT = CLK_FREQ / BAUD_RATE;

reg [15:0] baud_counter;
reg [3:0] bit_index;
reg [9:0] rx_shift_reg;
reg busy;

always @(posedge clk or posedge rst) begin
    if(rst) begin
        rx_data <= 0;
        rx_done <= 1'b0;
        busy <= 1'b0;
        baud_counter <= 0;
        bit_index <= 0;
    end
    else begin
        if(!rx && !busy) begin
            busy <= 1'b1;
            baud_counter <= BAUD_COUNT/2;
            bit_index <= 0;
            rx_done <= 1'b0;
        end
        
        if(busy) begin
            if(baud_counter < BAUD_COUNT-1)
                baud_counter <= baud_counter + 1;
            else begin
                baud_counter <= 0;
                rx_shift_reg[bit_index] <= rx;
                if(bit_index < 9)
                    bit_index <= bit_index + 1;
                else begin
                    rx_data <= rx_shift_reg[8:1];
                    busy <= 1'b0;
                    rx_done <= 1'b1;
                end
            end
        end
    end
end

endmodule