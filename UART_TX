module uart_tx (
    input clk,
    input rst,
    input tx_start,
    input [7:0] tx_data,
    output reg tx,
    output reg tx_done
);

parameter BAUD_RATE = 9600;
parameter CLK_FREQ = 50000000;
parameter BAUD_COUNT = CLK_FREQ / BAUD_RATE;

reg [15:0] baud_counter;
reg [3:0] bit_index;
reg [9:0] tx_shift_reg;
reg busy;

always @(posedge clk or posedge rst) begin
    if(rst) begin
        tx <= 1'b1;
        tx_done <= 1'b0;
        busy <= 1'b0;
        baud_counter <= 0;
        bit_index <= 0;
    end
    else begin
        if(tx_start && !busy) begin
            busy <= 1'b1;
            tx_shift_reg <= {1'b1, tx_data, 1'b0};
            bit_index <= 0;
            baud_counter <= 0;
            tx_done <= 1'b0;
        end
        
        if(busy) begin
            if(baud_counter < BAUD_COUNT-1)
                baud_counter <= baud_counter + 1;
            else begin
                baud_counter <= 0;
                tx <= tx_shift_reg[bit_index];
                if(bit_index < 9)
                    bit_index <= bit_index + 1;
                else begin
                    busy <= 1'b0;
                    tx_done <= 1'b1;
                end
            end
        end
    end
end

endmodule